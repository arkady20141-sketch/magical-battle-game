##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, to run this script, type that shell name before the whole
#       command line, like:
#
#           ksh Gradle
#
#       Busybox and similar reduced functionality shells are not supported.
#
#   (2) For OSX (Darwin), place the Gradle distribution in a directory
#       that has no spaces in the path.  OSX's default 'bash' has a bug in
#       the 'pushd' command, which prevents operation when there are spaces
#       in the path.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"*/}  # leaves a trailing / for empty
    [ -h "$app_path" ]
do
    cd "$APP_HOME"
    app_path=$( readlink -f "$app_path" || echo "$app_path" )
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
case "$( uname )" in
    CYGWIN* )
        cygwin=true
        ;;
    Darwin* )
        darwin=true
        ;;
    MSYS* | MINGW* )
        msys=true
        ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/bin/java" ] ; then
        JAVACMD=$JAVA_HOME/bin/java
    else
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$msys" ; then
    case $MAX_FD in #(
      max*)
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
        ;;
    esac
    case $MAX_FD in #(
      '' | soft) :
        ;;
      *)              
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
        ;;
    esac
fi

# Collect all arguments for the java command, following the shell quoting and substitution rules
# Check for -Dgradle.user.home
eval set -- $DEBUG_PORT_OPT $DAEMON_OPT $@
while [ $# -gt 0 ]
do
    case "$1" in
    -Dgradle.user.home=*)
        GRADLE_USER_HOME=${1#*=}
        shift
        ;;
    --no-daemon)
        DAEMON_OPT="--no-daemon"
        shift
        ;;
    --daemon)
        DAEMON_OPT="--daemon"
        shift
        ;;
    -D* | -X* | -XX* | -agentlib: | -agentpath: | -javaagent: | -Djava.security.manager= | -Djava.security.policy= | -Djava.class.path= )
        JAVA_OPTS="$JAVA_OPTS $1"
        shift
        ;;
    -classpath | --class-path | -cp | --cp)
        shift
        JAVA_OPTS="$JAVA_OPTS -classpath $1"
        shift
        ;;
    -d32 | -d64)
        JAVA_OPTS="$JAVA_OPTS $1"
        shift
        ;;
    -?*)
        JAVA_OPTS="$JAVA_OPTS $1"
        shift
        ;;
    -*)
        # Pass through any other - prefixed option
        JAVA_OPTS="$JAVA_OPTS $1"
        shift
        ;;
    *)
        break
        ;;
    esac
done

# Resolve the path to the Gradle distribution
GRADLE_DIST_URL="https://services.gradle.org/distributions/gradle-8.0-bin.zip"
GRADLE_DIST_PATH="$APP_HOME/gradle/wrapper/gradle-8.0-bin.zip"

# Check if the distribution is already available
if [ -f "$GRADLE_DIST_PATH" ] ; then
    # We have a cached copy, use it
    GRADLE_DIST_DIR="$APP_HOME/gradle/wrapper/gradle-8.0"
else
    # We don't have a cached copy, download it
    GRADLE_DIST_DIR="$APP_HOME/gradle/wrapper/gradle-8.0"
    mkdir -p "$GRADLE_DIST_DIR"
    
    # Download the distribution
    echo "Downloading Gradle distribution from $GRADLE_DIST_URL"
    
    # Use wget if available, otherwise curl
    if command -v wget > /dev/null 2>&1; then
        wget --no-check-certificate -q -O "$GRADLE_DIST_PATH.tmp" "$GRADLE_DIST_URL" || die "Could not download Gradle distribution from $GRADLE_DIST_URL"
    elif command -v curl > /dev/null 2>&1; then
        curl -L -s -o "$GRADLE_DIST_PATH.tmp" "$GRADLE_DIST_URL" || die "Could not download Gradle distribution from $GRADLE_DIST_URL"
    else
        die "Neither wget nor curl is available. Cannot download Gradle distribution from $GRADLE_DIST_URL"
    fi
    
    # Rename the temporary file
    mv "$GRADLE_DIST_PATH.tmp" "$GRADLE_DIST_PATH" || die "Could not rename temporary file to $GRADLE_DIST_PATH"
    
    # Extract the distribution
    cd "$GRADLE_DIST_DIR" || die "Could not change to directory $GRADLE_DIST_DIR"
    unzip -q "$GRADLE_DIST_PATH" || die "Could not extract Gradle distribution from $GRADLE_DIST_PATH"
    cd "$APP_HOME" || die "Could not change back to directory $APP_HOME"
fi

# Set up the classpath
CLASSPATH="$CLASSPATH:$GRADLE_DIST_DIR/lib/gradle-launcher-8.0.jar"

# Execute Gradle
exec "$JAVACMD" $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
